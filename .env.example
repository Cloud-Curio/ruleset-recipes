# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/political_social_network
DB_HOST=localhost
DB_PORT=5432
DB_NAME=political_social_network
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Keys for Government Data Sources
CONGRESS_API_KEY=your-congress-api-key
GOVINFO_API_KEY=your-govinfo-api-key
OPENSTATES_API_KEY=your-openstates-api-key

# External API URLs
CONGRESS_API_URL=https://api.congress.gov/v3
GOVINFO_API_URL=https://api.govinfo.gov
OPENSTATES_API_URL=https://v3.openstates.org

# Application Configuration
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics Configuration
ANALYTICS_BATCH_SIZE=1000
SIMILARITY_THRESHOLD=0.7
NLP_MODEL_PATH=./models/political-nlp

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Background Jobs
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# Data Ingestion Schedule (cron format)
CONGRESS_SYNC_SCHEDULE=0 2 * * *
GOVINFO_SYNC_SCHEDULE=0 3 * * *
OPENSTATES_SYNC_SCHEDULE=0 4 * * *

# Cache TTL (in seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# Monitoring
SENTRY_DSN=your-sentry-dsn
ENABLE_METRICS=true
METRICS_PORT=9090

