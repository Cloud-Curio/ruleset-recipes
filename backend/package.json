{
  "name": "political-social-network-backend",
  "version": "1.0.0",
  "description": "Backend API for Political Social Network Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make",
    "jobs:start": "node dist/jobs/worker.js",
    "jobs:dashboard": "node dist/jobs/dashboard.js",
    "db:reset": "npm run migrate:rollback && npm run migrate && npm run seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "cors": "^2.8.5",
    "@types/cors": "^2.8.17",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "@types/morgan": "^1.9.9",
    "compression": "^1.7.4",
    "@types/compression": "^1.7.5",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "jsonwebtoken": "^9.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "knex": "^3.0.1",
    "pg": "^8.11.3",
    "@types/pg": "^8.10.9",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "bull": "^4.12.0",
    "@types/bull": "^4.10.0",
    "bull-board": "^2.1.3",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "natural": "^6.8.0",
    "@types/natural": "^5.1.5",
    "compromise": "^14.10.0",
    "sentiment": "^5.0.2",
    "ml-matrix": "^6.10.7",
    "stopword": "^2.0.8",
